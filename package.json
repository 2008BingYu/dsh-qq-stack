{
  "name": "dsh-qq-stack",
  "version": "1.0.5",
  "type": "module",
  "main": "./index.js",
  "description": "DeepSeek Harness 的 QQ 协议端底座：LinuxQQ 与 NapCat 随引擎启动，提供标准 OneBot 11 接口。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "qq",
    "napcat",
    "onebot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "index.js",
    "client.js",
    "install.sh",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "scripts": {
    "test": "node --input-type=module -e \"await import('./index.js')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2008BingYu/dsh-qq-stack.git"
  },
  "homepage": "https://github.com/2008BingYu/dsh-qq-stack#readme",
  "bugs": {
    "url": "https://github.com/2008BingYu/dsh-qq-stack/issues"
  }
}
